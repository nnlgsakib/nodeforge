+
+  const handleSubmit = () => {
+    const trimmed = input.trim();
+    // Parse "new <project-name>" command
+    const newMatch = trimmed.match(/^new\s+(\S+)$/i);
+    if (newMatch) {
+      onCreateProject(newMatch[1]);
+      setInput('');
+      return;
+    }
+    // Handle other chat input (not implemented yet)
+    setInput('');
+  };
+
+  return (
+    <div className="chat-panel">
